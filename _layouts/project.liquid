---
layout: page
---

{% assign themes = site.data.themes | sort: "order" %}

<div class="project-meta">
  {% if page.status %}<span class="project-status project-status-{{ page.status }}">{{ page.status }}</span>{% endif %}
  {% if page.start %}<span class="project-dates">{{ page.start }}{% if page.end %} to {{ page.end }}{% else %} to present{% endif %}</span>{% endif %}
</div>

{% if page.themes != blank %}
<div class="project-tags">
{% for s in page.themes %}
  {% assign t = themes | where: "slug", s | first %}
  {% if t %}<a class="project-tag" href="{{ '/projects/' | relative_url }}?theme={{ s }}">{{ t.short | default: t.name }}</a>{% endif %}
{% endfor %}
</div>
{% endif %}

{% if page.image %}
<img class="project-hero" src="{{ page.image | prepend: '/assets/img/projects/' | relative_url }}" alt="{{ page.title }}">
{% endif %}

<div class="project-content">
{{ content }}
</div>

{% if page.papers != blank %}
<div class="project-pubs">
  <div class="project-info-label">Publications</div>
  <ul class="project-list">
  {% for pub in page.papers %}
    <li class="project-pub">
        <span class="project-pub-title"><a href="{{ '/publications/' | prepend: site.baseurl | append: pub.key | append: '/' }}">{{ pub.title }}</a></span>
      <span class="project-pub-meta">{{ pub.authors | join: ", " }}. {{ pub.venue }}{% if pub.year != "" %}, {{ pub.year }}{% endif %}.</span>
      {% if pub.pdf != "" or pub.doi != "" %}
      <span class="project-pub-links">
        {% if pub.pdf != "" %}
          {% if pub.pdf contains "://" %}{% assign pdf_url = pub.pdf %}{% else %}{% assign pdf_url = pub.pdf | prepend: '/assets/pdf/' | relative_url %}{% endif %}
          <a href="{{ pdf_url }}">PDF</a>
        {% endif %}
        {% if pub.doi != "" %}<a href="https://doi.org/{{ pub.doi }}">DOI</a>{% endif %}
      </span>
      {% endif %}
    </li>
  {% endfor %}
  </ul>
</div>
{% endif %}

<div class="project-info">
  {% if page.lead != blank or page.members != blank %}
  <div class="project-info-block">
    <div class="project-info-label">Team</div>
    <ul class="project-list">
      {% if page.lead %}<li>{{ page.lead }} <span class="project-role">lead</span></li>{% endif %}
      {% for m in page.members %}<li>{{ m }}</li>{% endfor %}
    </ul>
  </div>
  {% endif %}

  {% if page.partners != blank %}
  <div class="project-info-block">
    <div class="project-info-label">Partners</div>
    <ul class="project-list">
      {% for p in page.partners %}<li>{{ p }}</li>{% endfor %}
    </ul>
  </div>
  {% endif %}

  {% if page.grants != blank %}
  <div class="project-info-block">
    <div class="project-info-label">Funding</div>
    <ul class="project-list">
    {% for gid in page.grants %}
      {% assign gr = site.data.grants | where: "id", gid | first %}
      {% if gr %}
      <li>{% if gr.url %}<a href="{{ gr.url }}">{{ gr.title }}</a>{% else %}{{ gr.title }}{% endif %}. {{ gr.agency }}{% if gr.program %}, {{ gr.program }}{% endif %}</li>
      {% endif %}
    {% endfor %}
    </ul>
  </div>
  {% endif %}
</div>

<p class="project-back"><a href="{{ '/projects/' | relative_url }}">Back to projects</a></p>

<style>
.project-meta {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 0.75rem;
}
.project-status {
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  padding: 0.2rem 0.6rem;
  border-radius: 999px;
  border: 1px solid var(--global-divider-color);
  color: var(--global-text-color-light);
}
.project-status-active {
  background: var(--global-theme-color);
  border-color: var(--global-theme-color);
  color: #fff;
}
.project-dates { font-size: 0.85rem; color: var(--global-text-color-light); }
.project-tags { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-bottom: 1.25rem; }
.project-tag {
  font-size: 0.75rem;
  padding: 0.2rem 0.6rem;
  border-radius: 999px;
  border: 1px solid var(--global-divider-color);
  color: var(--global-text-color-light);
}
.project-tag:hover { border-color: var(--global-theme-color); text-decoration: none; }
.project-hero {
  width: 100%;
  border-radius: 10px;
  margin-bottom: 1.5rem;
}
.project-info {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 1.5rem;
  margin-top: 2rem;
  padding-top: 1.5rem;
  border-top: 1px solid var(--global-divider-color);
}
.project-info-label {
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--global-text-color-light);
  margin-bottom: 0.5rem;
}
.project-list { list-style: none; padding: 0; margin: 0; font-size: 0.9rem; line-height: 1.7; }
.project-role { font-size: 0.75rem; color: var(--global-text-color-light); }
.project-back { margin-top: 2rem; font-size: 0.9rem; }

.project-pubs {
  margin-top: 2rem;
  padding-top: 1.5rem;
  border-top: 1px solid var(--global-divider-color);
}
.project-pub { margin-bottom: 0.9rem; line-height: 1.4; }
.project-pub-title { display: block; font-weight: 600; }
.project-pub-meta {
  display: block;
  font-size: 0.82rem;
  color: var(--global-text-color-light);
}
.project-pub-links { font-size: 0.8rem; display: inline-flex; gap: 0.6rem; margin-top: 0.15rem; }
</style>