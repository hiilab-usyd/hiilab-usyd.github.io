---
layout: page
title: projects
permalink: /projects/
description: Research projects running in the HII Lab.
nav: true
nav_order: 4
---

{% assign themes = site.data.themes | sort: "order" %}
{% assign all = site.projects | sort: "importance" %}

<div class="proj-filters">
  <button class="proj-chip active" data-theme="all">All</button>
  {% for t in themes %}
  <button class="proj-chip" data-theme="{{ t.slug }}">{{ t.short | default: t.name }}</button>
  {% endfor %}
</div>

{% assign groups = "active,completed" | split: "," %}
{% assign labels = "Active,Completed" | split: "," %}
{% for g in groups %}
{% assign items = all | where: "status", g %}
{% if items.size > 0 %}
<h2 class="proj-heading" data-group="{{ g }}">{{ labels[forloop.index0] }}</h2>
<div class="proj-grid" data-group="{{ g }}">
{% for p in items %}
<a class="proj-card" href="{{ p.url | relative_url }}" data-themes="{{ p.themes | join: ' ' }}">
  {% if p.image %}
  <img class="proj-img" src="{{ p.image | prepend: '/assets/img/projects/' | relative_url }}" alt="{{ p.title }}" loading="lazy">
  {% endif %}
  <div class="proj-body">
    <div class="proj-title">{{ p.title }}</div>
    {% if p.summary %}<p class="proj-summary">{{ p.summary }}</p>{% endif %}
    <div class="proj-tags">
      {% for s in p.themes %}
        {% assign t = themes | where: "slug", s | first %}
        {% if t %}<span class="proj-tag">{{ t.short | default: t.name }}</span>{% endif %}
      {% endfor %}
    </div>
  </div>
</a>
{% endfor %}
</div>
{% endif %}
{% endfor %}

{% if all.size == 0 %}
<p class="proj-none">No projects have been added yet.</p>
{% endif %}

<p class="proj-empty" hidden>No projects match that theme.</p>

<style>
[hidden] { display: none !important; }
.proj-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  margin: 1.5rem 0 0.5rem;
}
.proj-chip {
  font-size: 0.8rem;
  padding: 0.3rem 0.8rem;
  border: 1px solid var(--global-divider-color);
  border-radius: 999px;
  background: transparent;
  color: var(--global-text-color-light);
  cursor: pointer;
  transition: all 0.15s ease;
}
.proj-chip:hover { border-color: var(--global-theme-color); }
.proj-chip.active {
  background: var(--global-theme-color);
  border-color: var(--global-theme-color);
  color: #fff;
}
.proj-heading {
  margin-top: 2.25rem;
  margin-bottom: 1rem;
  padding-bottom: 0.4rem;
  border-bottom: 1px solid var(--global-divider-color);
  font-size: 1.35rem;
}
.proj-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 1.25rem;
}
.proj-card {
  display: flex;
  flex-direction: column;
  border: 1px solid var(--global-divider-color);
  border-radius: 10px;
  overflow: hidden;
  background: var(--global-card-bg-color);
  color: inherit;
  text-decoration: none;
  transition: box-shadow 0.2s ease, transform 0.2s ease;
}
.proj-card:hover {
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
  transform: translateY(-2px);
  text-decoration: none;
  color: inherit;
}
.proj-img {
  width: 100%;
  aspect-ratio: 16 / 9;
  object-fit: cover;
}
.proj-body { padding: 1rem 1.1rem 1.1rem; }
.proj-title { font-weight: 600; line-height: 1.3; margin-bottom: 0.4rem; }
.proj-summary {
  font-size: 0.85rem;
  line-height: 1.5;
  color: var(--global-text-color-light);
  margin-bottom: 0.7rem;
}
.proj-tags { display: flex; flex-wrap: wrap; gap: 0.3rem; }
.proj-tag {
  font-size: 0.7rem;
  padding: 0.15rem 0.5rem;
  border-radius: 999px;
  background: var(--global-bg-color);
  border: 1px solid var(--global-divider-color);
  color: var(--global-text-color-light);
}
.proj-none, .proj-empty {
  margin-top: 1.5rem;
  color: var(--global-text-color-light);
  font-size: 0.9rem;
}
</style>

<script>
(function () {
  var chips = document.querySelectorAll(".proj-chip");
  var cards = document.querySelectorAll(".proj-card");
  var empty = document.querySelector(".proj-empty");
  if (!chips.length) return;

  function apply(theme) {
    var shown = 0;
    cards.forEach(function (c) {
      var list = " " + (c.dataset.themes || "") + " ";
      var match = theme === "all" || list.indexOf(" " + theme + " ") > -1;
      c.hidden = !match;
      if (match) shown++;
    });
    document.querySelectorAll(".proj-grid").forEach(function (grid) {
      var any = grid.querySelectorAll(".proj-card:not([hidden])").length > 0;
      grid.hidden = !any;
      var h = document.querySelector('.proj-heading[data-group="' + grid.dataset.group + '"]');
      if (h) h.hidden = !any;
    });
    if (empty) empty.hidden = shown > 0 || cards.length === 0;
    chips.forEach(function (b) {
      b.classList.toggle("active", b.dataset.theme === theme);
    });
    var url = new URL(window.location);
    if (theme === "all") { url.searchParams.delete("theme"); }
    else { url.searchParams.set("theme", theme); }
    history.replaceState(null, "", url);
  }

  chips.forEach(function (b) {
    b.addEventListener("click", function () { apply(b.dataset.theme); });
  });

  apply(new URLSearchParams(window.location.search).get("theme") || "all");
})();
</script>